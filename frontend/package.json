{
  "name": "berserk-archive-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:pages": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "build:preview": "tsc -b && VITE_ROUTER=hash BASE_PATH=./ vite build",
    "panels": "tsx scripts/panel-slots.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
